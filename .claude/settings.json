{
  "enabledPlugins": {
    "playwright@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(npm:*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-deploy-guard.sh\"",
            "statusMessage": "Live-deploy guard...",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
